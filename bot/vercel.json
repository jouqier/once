{
  "version": 2,
  "builds": [
    {
      "src": "api/story-upload.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/story-image.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/story-upload",
      "dest": "api/story-upload.js"
    },
    {
      "src": "/api/story-image",
      "dest": "api/story-image.js"
    }
  ]
}
